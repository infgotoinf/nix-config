-1);
draw(d#IN,IN#_width,IN#_height,IN#_depth,IN#_spectrum,
d#OUT1,IN#_width - OUT1#_width,IN#_height - OUT1#_height,
IN#_depth - OUT1#_depth,IN#_spectrum - OUT1#_spectrum,
OUT1#_width,OUT1#_height,OUT1#_depth,OUT1#_spectrum,
