out_vector=["${}"];
const max_index=s-1;
const dec_max_index=max_index-1;
started=0;
reverse_array_starting_from(a)=(
start=a;
end=max_index;
while(start<end,
swap(out_vector[start++],out_vector[end--]);
);
);
);
if(started,
for(jp=dec_max_index,jp>-1,--jp,
