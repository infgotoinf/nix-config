#@cli nn_print
#@cli : Print info on current neural network.
nn_print :
net=$_nn_network
use_vt100 g=$_vt100_g c=$_vt100_c n=$_vt100_n r=$_vt100_r b=$_vt100_b
e[^-1] "[nn_lib] Print info on neural network '"$net"'."
v 0 e " * Network name: "$b$net$n
repeat narg(${_${net}_layer_names})-1 {
type=${arg0\ $>,${_${net}_layer_types}}
name=${arg0\ $>,${_${net}_layer_names}}
learning_mode=${_${net}_${name}_learning_mode}
properties=${_${net}_${name}_properties}
input=${_${net}_${name}_input}
if narg($input)==1
input_siz=${_${net}_${input}_size}
else
input_siz,sep=
repeat narg($input) {
in=${arg0\ $>,$input}
if isnum($in) input_siz.=1
else input_siz.=$sep${_${net}_${in}_size}
fi
sep=" and "
}
fi
e "   - Layer: "$b$name$n" (type: "$g$type$n")"
if ['$input']!=0
s={`find(['$input'],_',')>0?_'s':0`}
e "       * Input"$s": "$c$input$n" ("$input_siz")"
fi
if isin('$type','conv2d','conv3d','fc','mp','normalize')
e "       * Parameters: "$c{${net}_${name},whds}$n
fi
e "       * Output size: "$c${_${net}_${name}_size}$n
if ['$properties']!=0
ies={`find(['$properties'],_',')>0?'ies':[_'y',0,0]`}
e "       * Propert"$ies": "$c$properties$n
fi
if isint(${$name})
e "       * Parameters: "$c{$name,whds}$n
fi
}
e "\n * Total: "${b}{narg(${_${net}_layer_names})-1}$n" layers, "$b${-nn_size}$n" parameters.\n"
