Y_Ombre=$31
Smoothness_Ombre=$32
Curvature_Ombre=$33
if $Exemples==1
Egalite_Param_X_Y=1
Cax=1
Cbx=0.5
Ccx=0.25
Vbx=7
Vcx=21
Theta=1000
elif $Exemples==2
Egalite_Param_X_Y=1
Cax=1
Cbx=5
Ccx=2
Vbx=3
Vcx=10
Theta=4693
elif $Exemples==3
Egalite_Param_X_Y=0
Cax=1
Cbx=0.5
Ccx=0.33
Vbx=7
Vcx=17
Cay=1
Cby=0.5
Ccy=0.33
Vby=11
Vcy=17
Theta=4886
elif $Exemples==4
Egalite_Param_X_Y=0
Cax=1
Cbx=0.5
Ccx=0.33
Vbx=7
Vcx=17
Cay=1
Cby=0.5
Ccy=0.33
Vby=7
Vcy=3
Theta=4520
elif $Exemples==5
Egalite_Param_X_Y=0
Cax=1
Cbx=0.5
Ccx=0.25
Vbx=1
Vcx=6
Cay=0.8
Cby=0.2
Ccy=1
Vby=9
Vcy=12
