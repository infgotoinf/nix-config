Xp1=$1
Yp1=$2
Xp2=$3
Yp2=$4
Xp3=$5
Yp3=$6
Xp4=$7
Yp4=$8
Segments=$9
Index=1
Xori=$1
Yori=$2
repeat $Segments
Tou={$Index/$Segments}
XTou={{{{1-$Tou}^3}*$Xp1}+{{{1-$Tou}^2}*3*$Tou*$Xp2}+{3*{1-$Tou}*{$Tou^2}*$Xp3}+{{$Tou^3}*$Xp4}}
YTou={{{{1-$Tou}^3}*$Yp1}+{{{1-$Tou}^2}*3*$Tou*$Yp2}+{3*{1-$Tou}*{$Tou^2}*$Yp3}+{{$Tou^3}*$Yp4}}
line. $Xori,$Yori,$XTou,$YTou,1,$10,$11,$12,$13
Xori=$XTou
Yori=$YTou
Index+=1
done
