iain_skin_mask:
dark={$1}
pale={255-$2}
red={255-$3}
yellow={255-$4}
to_rgb
[0]
[0]
[0]
l[1]
if $3>0
red={255-$3}
fill if(i(x,y,z,0)-i(x,y,z,1)<{$red},i,0)
gt 0
else
fill 1
fi
done
l[2]
rgb2cmyk
dark={$1}
pale={255-$2}
fill if(i(x,y,z,2)>i(x,y,z,1),if(i(x,y,z,2)-i(x,y,z,1)<{$dark},if((i(x,y,z,0)+{$pale})<i(x,y,z,2),i,255),255),255)
cmyk2rgb
gt 0
done
l[3]
if $4>0
yellow={255-$4}
rgb2hsv
split c
keep[0]
add[0] 180
mod[0] 360
lt[0] $yellow
else
fill 1
fi
done
mul[1,2,3]
mul[1] 255
channels[1] 0
if $5
keep[1]
else
append c
fi
