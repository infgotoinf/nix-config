C = solve(M,crop(#-1),1));
dot([x^2,y^2,x*y,x,y,1],C)\"",$1,$2,1,$4%,$5%,0,3
else
apply_tiles "
f \"begin(M = permute(expr('[x^3,y^3,x^2*y,x*y^2,x^2,y^2,x*y,x,y,1]',w,h,1,10),w,h,1,10,'cxyz');
C = solve(M,crop(#-1),1));
dot([x^3,y^3,x^2*y,x*y^2,x^2,y^2,x*y,x,y,1],C)\"",$1,$2,1,$4%,$5%,0,3
fi
a c
}
