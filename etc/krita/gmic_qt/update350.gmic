fx = x%N; fy = y%N;
xi = int(x/N); yi = int(y/N); ci = fx + N*fy + N2*c;
xi + w/N*yi + wh/N2*z + whd/N2*ci',
IN#_width,IN#_height,IN#_depth,IN#_spectrum);
