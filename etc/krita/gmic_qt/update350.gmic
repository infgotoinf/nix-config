if(radius>r2,sign=1)
);
if(sign<0,
ratio=r2/r1*cos(angle);
ratioi=r2/r1*sin(angle)
);
if(sign>0,
ratio=r1/r2*cos(angle);
ratioi=-r1/r2*sin(angle)
);
