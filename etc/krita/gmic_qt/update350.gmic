e[^-1] "Draw Sierpinski triangle of degree $1 on image$?."
_samj_sierpinski_absolu ${2-11},$1
_samj_sierpinski_absolu :
if $11<=0 polygon 3,$1,$2,$3,$4,$5,$6,1,$7,$8,$9,$10 return fi
