((i>=225)&&(i<237))?[242,114,195]+(i-225)*[-115,-114,-68]/11:
((i>=237)&&(i<255))?[255,255,0]+(i-237)*[-255,-255,0]/17:
((i>=255)&&(i<256))?[255,255,255]"
fi
if $8 rgb2srgb fi
done
f[^-1] "I[#-1,i]"
rm.
