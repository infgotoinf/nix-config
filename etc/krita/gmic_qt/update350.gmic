rotation3d[] {"
const w2 = "{*,w}"/2;
const h2 = "{*,h}"/2;
const R = 0.375*min("{*,w,h}");
const u0 = "$mx0" - w2;
const v0 = "$my0" - h2;
const u1 = "$mx1" - w2;
const v1 = "$my1" - h2;
n0 = norm(u0,v0);
nu0 = n0>R?u0*R/n0:u0;
nv0 = n0>R?v0*R/n0:v0;
nw0 = sqrt(max(0,R^2 - nu0^2 - nv0^2));
n1 = norm(u1,v1);
nu1 = n1>R?u1*R/n1:u1;
nv1 = n1>R?v1*R/n1:v1;
nw1 = sqrt(max(0,R^2 - nu1^2 - nv1^2));
u = nv0*nw1 - nw0*nv1;
v = nw0*nu1 - nu0*nw1;
w = nv0*nu1 - nu0*nv1;
n = norm(u,v,w);
[ u,v,w,-asin(n/R^2)*180/pi ]"}
