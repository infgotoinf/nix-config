fx_crayongraffiti2 :
repeat $! l[$>] split_opacity l[0]
+b $3 hardsketchbw. $1,$2,$4,$5,$6 to_rgb
negate. b.. xy,$7 reverse
if $8==0 compose_lightness
elif $8==1 compose_value
