is_change 0
#@cli poincare_disk : _size>=0,_p>2,_q>2,_angle,_tiling={ 0:Triangular | 1:Polygonal },_nb_max_iter>=0,_xmin,_ymin,_xmax,_ymax
#@cli : Return a 3-channels image of a poincare disk. Output channels are '[x,y,it]'.
#@cli : Default values: 'size=1024', 'p=5', 'q=3', 'angle=0', 'tiling=0', 'nb_max_iter=20', 'xmin=ymin=-1' and 'xmax=ymax=1'.
#@cli : repeat 4 { poincare_disk 1024,{3+$>} channels[-1] 2 mod[-1] 3 neq[-1] 2 } rescale2d 50%
+poincare_disk : check "isint(${1=1024},1) && isint(${2=5},3) && isint(${3=4},3) && ""isbool(${5=0}) && isint(${6=20},0)" skip "${4=0},${7=-1},${8=-1},${9=1},${10=1}"
s0,s1=triangular,polygon
e[^-1] "Input a $1x$1 poincare disk, with p = $2, q = $3, angle $4 deg., "$s$5" tiling, $6 max iterations, ""in region ($7,$8)-($9,$10)."
$1,$1,1,3,"
begin(
const p = $2;
const q = max($3,ceil(4/(p - 2) + 2.5));
const tiling = $5;
const nb_iter = $6;
const it_max = (tiling?1:3)*nb_iter;
const one = w%2?0:1;
const angle = ($4%360)°;
R = rot(-angle);
Rt = rot(angle);
const pi2 = 2*pi;
const pip = pi/p;
const pi2p = 2*pip;
const cosq2 = cos(pi/q)^2;
const sinp2 = sin(pip)^2;
const delta = cosq2 - sinp2;
const r0 = sqrt(sinp2/delta);
const x0 = sqrt(cosq2/delta);
const y0 = 0;
unreachable = [ -2,-2,-2 ];
);
_x = lerp($7,$9,x/(w - one));
_y = lerp($8,$10,y/(h - one));
angle?(P = R*[ _x,_y ]; x = P[0]; y = P[1]):(x = _x; y = _y);
r = norm(x,y);
r>1?unreachable:(
t = atan2(y,x)%pi2;
repeat (it_max,it,
tiling?(
trm = round(t,pi2p)%pi2;
C = rot(trm)*[ x0,y0 ];
is_inside_region = norm(x - C[0], y - C[1])>=r0;
):(
C = [ x0,y0 ];
is_inside_region = t<pip && norm(x - x0, y -  y0)>=r0;
);
is_inside_region?break();
tiling || (it3 = it%3)==2?(
u = x - C[0];
v = y - C[1];
nr = norm(u,v);
x = C[0] + u*r0^2/nr^2;
y = C[1] + v*r0^2/nr^2;
r = norm(x,y);
t = atan2(y,x)%pi2;
):it3==1?(
y*=-1;
t = -t + pi2;
):(
t = (((t + pip)%pi2p) - pip)%pi2;
x = r*cos(t); y = r*sin(t);
);
);
it>=it_max?unreachable:angle?(P = Rt*[x,y]; [ P,it ]):[ x,y,it ];
)"
