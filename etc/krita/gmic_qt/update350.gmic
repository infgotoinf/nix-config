fi
$Largeur_Origine,$Hauteur_Origine,1,4
if $Ombre>0 polygon[-1] 4,0,0,{$Largeur_Origine-1},0,{$Largeur_Origine-1},{$Hauteur_Origine-1},0,{$Hauteur_Origine-1},1,0xFFFFFFFF,0,0,0,1 fi
Nb_boucles_superpositions=0
repeat $Nombre_de_superpositions
