samj_Decoupage_Triangle :
skip ${1=2},${2=5},${3=0},${4=0},${5=0}
Haut={h}
Larg={w}
shift $4,$5,0,0,2
resize {round($Larg/$1)*$1},{round($Haut/$1)*$1}
split y,$1
split x,$1
if $2<6
imagegrid_triangular {w},{h},$2,0,0,0,0
else
NbImg=$!
Index=0
repeat $NbImg
Index-=1
imagegrid_triangular[$Index] {w},{h},{$Index%6},0,0,0,0
done
fi
if $3>0 spread $3 fi
append x
split x,$1
append y
resize $Larg,$Haut
shift[-1] -$4,-$5,0,0,2
