fi
else
if {*,ARROWLEFT}" || "{*,ARROWRIGHT}
step:=ceil(($Xmax-$Xmin)/8)
if {*,ARROWLEFT} nXmin:=max(0,$Xmin-$step) Xmin,Xmax:=$nXmin,$Xmax+$nXmin-$Xmin
else nXmax:=min(w#0-1,$Xmax+$step) Xmin,Xmax:=$Xmin+$nXmax-$Xmax,$nXmax
fi
