samj_fx_custom_deformation_327 "(w+h)/20 * cos(y*20/h)","(w+h)/20 * sin(x*20/w)",1,1,3
fx_array_mirror 1,0,0,2,0,0,0
elif $3==3
fx_kaleidoscope 50,50,0,0,100,0,3
fx_array_mirror 1,0,0,2,0,0,0
elif $3==5
fx_array_mirror 1,0,0,2,0,0,0
fi
}
samj_Pseudo_Vitrail :
