1,1,1,2
eval.. ">
begin(ret = [ 0,0 ]; pP = I);
P = I; norm(P - pP)>1e-3?(da_push(pP); pP = P);
end(
da_size()?(norm(P - da_back())>1e-3?da_push(P)):da_push(I[0]);
da_freeze();
