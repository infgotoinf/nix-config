fx_random3d :
foreach {
f3d:=0.5*max(w,h)/tan($5*pi/360) f3d $f3d l3d {$6*$f3d},{$7*$f3d},{$8*$f3d} sl3d $9 ss3d $10
to_rgb ({w},{h},{d},{s}) /. 2
repeat $2 {
({1,@0}) +. {1,@1} *. $3 /. 100 _fx_random3d$1 {^} rm..
r3d. 1,1,0,{u(0,360)}
({u(-1,1)}) *. {1,@0} ({u(-1,1)}) *. {1,@1}
+3d... {-2,^},{^},{u(-$4,$4)} rm[-2,-1]
col3d. {u(255)},{u(255)},{u(255)}
}
+3d[2--1] j3d[0] .,50%,50%,0,$12,$11,0,1 k[0]
}
_fx_random3d0 : box3d $1
