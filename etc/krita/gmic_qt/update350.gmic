!non_escaped &&
isin(c,_'%',_'$',_'\\',_'\'',_'`',_'*',_'_',_'{',_'}',_'[',_']',_'<',_'>',_'(',_')',_'#',_'+',_'-',_'.',_'!')?(
res[ym1] = i[ym1] = 0;
):
linestart && c==_'#' && nc==_' '?( # Opening
section = y;
):
section>=0 && newline(c)?(
opening_offset = section;
res[section++] = s_section;
while (blank(res[section]), res[section++] = 0);
res[y] = e_section;
for (p = opening_offset - 1, p>=0 && res[p]==_'\n', res[p--] = 0);
for (p = ym1, p>opening_offset && blank(res[p]), res[p--] = 0);
for (p = y1, p<size(res) && blank(res[p]), res[p++] = 0);
):
