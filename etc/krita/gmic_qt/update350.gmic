fx_rainbow :
foreach {
100%,100% spline. 0,$1%,100,{-$3}%,100%,$2%,100,$4%,1,1
flood. 0,0,0,0,0,1,1 flood. {w-1},0,0,0,0,1,1
distance. 0 c. 0,255 n. 0,{$5*255}
