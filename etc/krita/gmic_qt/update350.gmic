previous_numbers_sum += v[q];
);
);
v[found_number_pos--]=0;
( total = (++v[found_number_pos])+previous_numbers_sum ) != max_sum ?(
mode = 1;
limit = max_sum-total;
);
);
);
I[#-2,p]=v;
);
"
rm. u $old_status
