fx_steampen :
repeat $! l[$>] split_opacity l[0]
fx_pencilbw $1,$2,0,0,0
fx_kuwahara $3,$4,0,0
b xy,$5
if $6==1 fx_normalize_local 4.8,22,6.89,20,1,3,0
elif $6==2 fx_contrast_swm 2,0,1
elif $6==3 fx_contrast_swm 2,1,1
