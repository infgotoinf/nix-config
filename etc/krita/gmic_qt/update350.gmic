gcd_stereo_img : skip ${1=0},${2=2},${3=1.2},${4=1},${5=0.25},${6=2},${7=4},${8=1},${9=0}
repeat $! l[$>]
to_rgb[0] b={abs($3%*w*$4)}
+gcd_depth[0] $5,$6,$7,$8
