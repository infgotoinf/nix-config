nn_optimizer_#O#_update(P#_alpha);
draw(##P#_ind_g2,d#P#_alpha_g2,0,0,1,h##P#_ind);
);
learning_mode&2?(
d#P#_beta_g2 = crop(##P#_ind_g2,1,1);
nn_optimizer_#O#_update(P#_beta);
