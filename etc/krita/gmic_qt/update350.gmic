nn_loss_normp_backward(OUT,IN,TRUTH) = (
nn_define_backward(IN#);
OUT#_metric==2?( # L2
d#IN+=OUT#_delta/(1e-8 + OUT#)*OUT#_weight;
):OUT#_metric==1?( # L1
d#IN+=sign(OUT#_delta)*OUT#_weight;
):OUT#_metric>1?( # Lp with p>1
d#IN+=(1e-8 + OUT#)^(1/OUT#_metric - 1)*abs(OUT#_delta)^(OUT#_metric - 1)*sign(OUT#_delta)*OUT#_weight;
):(
d#IN+=OUT#^(1/OUT#_metric - 1)*(1e-8 + abs(OUT#_delta))^(OUT#_metric - 1)*sign(OUT#_delta)*OUT#_weight;
);
);
nn_loss_softmax_crossentropy_init_forward(OUT,weight) = (
const OUT#_weight = weight;
batch_#OUT = 0;
);
nn_loss_softmax_crossentropy_forward(OUT,IN,TRUTH) = (
OUT#_softmax = vmax(softmax(IN#),1e-8);
OUT#_single = -sum(TRUTH*log(OUT#_softmax))/size(IN#)*OUT#_weight;
batch_#OUT+=OUT#_single;
);
nn_loss_softmax_crossentropy_end_forward(OUT) = (
merge(batch_#OUT,+);
batch_#OUT/=nn_batch_size;
OUT# = batch_#OUT;
);
nn_loss_softmax_crossentropy_backward(OUT,IN,TRUTH) = (
nn_define_backward(IN#);
d#IN+=(OUT#_softmax - TRUTH)*OUT#_weight;
);"
