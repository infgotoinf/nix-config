fx_stripes :
__fx_stripes_preview_ $*
l[] {
repeat 5 {
if $nb_sections>$>" && "${section$>_size}
1,${section$>_size},1,4,[${section$>_R},${section$>_G},${section$>_B},${section$>_A}]
if $outline_size 1,$outline_size,1,4,[$outline_R,$outline_G,$outline_B,$outline_A] fi
fi
}
a y
if $is_antialias r. 1,200%,1,4 fi
}
if $projection angle=0 fi
foreach[^-1] {
w,h:=w,h
{[$w,$h]*($is_antialias?2:1)},1,4
pass.
f.. "
begin(
const alignment = $alignment;
const projection = $projection;
const boundary = 2;
const angle = $angle;
R = angle==0?[1,0,0,1]:
angle==90?[0,1,-1,0]:
angle==180?[-1,0,0,-1]:
angle==270?[0,-1,1,0]:rot(-angle°);
alignment==0?(wa = ha = 0):alignment==1?(wa = round(w/2); ha = round(h/2)):(wa = w; ha = h);
);
projection?(
cx = x - w/2; cy = y - h/2; r = norm(cx,cy); x = 0;
y = projection==1?r:int(($1 + 180)/9)*h#-1*(1 + atan2(cy,cx)/pi);
);
XY = R*[ x - wa, y - ha ];
I(#-1,XY[0],XY[1])"
rm.
if $is_antialias
srgb2rgb. r. $w,$h,1,100%,2 rgb2srgb.
fi
blend alpha
}
rm.
fx_stripes_preview :
__fx_stripes_preview_ $*
fx_stripes $*
v1,v2,v3,v4:=$nb_sections>1?2:0,$nb_sections>2?2:0,$nb_sections>3?2:0,$nb_sections>4?2:0
u "{"{$angle>180?$angle-360:$angle}"}{"{$nb_sections-1}"}{"$alignment"}{"$projection"}{"$is_antialias"}""{"$outline_size"}{"$outline_R,$outline_G,$outline_B,$outline_A"}""{"$section0_size"}{"$section0_R,$section0_G,$section0_B,$section0_A"}""{"$section1_size"}"_$v1"{"$section1_R,$section1_G,$section1_B,$section1_A"}"_$v1"{"$section2_size"}"_$v2"{"$section2_R,$section2_G,$section2_B,$section2_A"}"_$v2"{"$section3_size"}"_$v3"{"$section3_R,$section3_G,$section3_B,$section3_A"}"_$v3"{"$section4_size"}"_$v4"{"$section4_R,$section4_G,$section4_B,$section4_A"}"_$v4
__fx_stripes_preview_ :
angle,nb_sections,alignment,projection,is_antialias,outline_size,outline_R,outline_G,outline_B,outline_A,section0_size,section0_R,section0_G,section0_B,section0_A,section1_size,section1_R,section1_G,section1_B,section1_A,section2_size,section2_R,section2_G,section2_B,section2_A,section3_size,section3_R,section3_G,section3_B,section3_A,section4_size,section4_R,section4_G,section4_B,section4_A=$*
angle:=$angle%360
nb_sections+=1
fx_tetris :
tetris $1
fx_triangular_pattern :
if !$! 1024,1024,1,3 fi
W,H={0,[w,h]} f:=arg0($14,1,1.5,2,3,4)*100 r[0] $f%,$f%,1,100%
1,1,1,6
eval "
srand($1);
const pn1 = $3;
const pn2 = $4 + pn1;
const pn3 = $5 + pn2;
const pn4 = $6 + pn3;
const pn5 = $7 + pn4;
C = [ w#0,h#0 ]/2;
da_push([ C,0,h#0-1,0,0 ],
[ C,w#0-1,0,0,0 ],
[ C,w#0-1,0,w#0-1,h#0-1 ],
[ C,0,h#0-1,w#0-1,h#0-1 ]);
repeat ($2,
n = v(pn5 - 1);
n = n<pn1?0:n<pn2?1:n<pn3?2:n<pn4?3:4;
is_hole = u<=$8%;
repeat (da_size(),k,
F = I[k]; P0 = F[0,2]; P1 = F[2,2]; P2 = F[4,2];
!n?(
P = lerp(P1,P2,0.5);
da_push([ P0,P,P1 ]);
I[k] = [ P0,P,P2 ];
):n==1?(
P = lerp(P0,P2,0.5);
da_push([ P1,P,P0 ]);
I[k] = [ P1,P,P2 ];
):n==2?(
P = lerp(P0,P1,0.5);
da_push([ P2,P,P0 ]);
I[k] = [ P2,P,P1 ];
):n==3?(
P = (P0 + P1 + P2)/3;
da_push([ P,P0,P1 ]);
da_push([ P,P1,P2 ]);
I[k] = [ P,P2,P0 ];
):(
P01 = lerp(P0,P1,0.5); P02 = lerp(P0,P2,0.5); P12 = lerp(P1,P2,0.5);
da_push([ P0,P01,P02 ]);
da_push([ P1,P12,P01 ]);
is_hole?(
I[k] = [ P2,P02,P12 ];
):(
da_push([ P2,P02,P12 ]);
I[k] = [ P01,P02,P12 ];
);
);
);
);
repeat (da_size(),k,
F = I[k];
polygon(#0,3,F,$9%,u([255,255,255]));
polygon(#0,-3,F,$13%/3,0xFFFFFFFF,$10,$11,$12,255);
)"
rm.
r[0] $W,$H,1,100%,2
fx_truchet :
foreach {
100%,100% truchet $1,$2,$4 rm..
if $5==1 * -1
elif $5==2 i[0] 100%,100%,1,1,1
elif $5==3 i[0] 100%,100%
elif $5==4 * -1 i[0] 100%,100%
elif $5==5 * -1 i[0] 100%,100%,1,1,-1
elif $5==6 label 0,1 {iM+1},1,1,3 rand. 0,255 map.. . rm.
fi
