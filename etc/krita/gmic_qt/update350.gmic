+shape_mosely : l[] { check "isint(${1=3},0)" nbi=$1 onfail noarg nbi=3 }
e[^-1] "Input a "$nbi"-iterated Mosely snowflake, as a 3D binary image."
3,3,3,1,"norm1([x,y,z]-1)<=2" =. 0,1,1,1 (1)
