_fx_tune_hsv :
mode_dark,Rdark,Gdark,Bdark,Hdark,Sdark,Vdark,mode_light,Rlight,Glight,Blight,Hlight,Slight,Vlight,mode_avg,Ravg,Gavg,Bavg,Havg,Savg,Vavg,mode_red,Rred,Gred,Bred,Hred,Sred,Vred,mode_yellow,Ryellow,Gyellow,Byellow,Hyellow,Syellow,Vyellow,mode_green,Rgreen,Ggreen,Bgreen,Hgreen,Sgreen,Vgreen,mode_cyan,Rcyan,Gcyan,Bcyan,Hcyan,Scyan,Vcyan,mode_blue,Rblue,Gblue,Bblue,Hblue,Sblue,Vblue,mode_magenta,Rmagenta,Gmagenta,Bmagenta,Hmagenta,Smagenta,Vmagenta,preview_mapping=${1-64}
all_colors=dark,light,avg,red,yellow,green,cyan,blue,magenta
foreach { split_opacity l[0] {
to_rgb
colors,sep=
repeat narg($all_colors) { color=${arg0\ $>,$all_colors} if ${mode_$color} colors.=$sep$color sep=, fi }
+srgb2lab channels. 0 darklight:="I(#-2,xm,ym),I(#-2,xM,yM)" rm.
dark:=[$darklight][0,3] light:=[$darklight][3,3]
+r. 1,1,1,3,2 avg={^} rm.
eval. ">
begin(
red = yellow = green = cyan = blue = magenta = [0,0,0];
best_red = best_yellow = best_green = best_cyan = best_blue = best_magenta = inf;
test_color(color,tR,tG,tB) = (
val = norm([tR,tG,tB]-[R,G,B]);
val<best_#color?(best_#color = val; color# = I(#-2));
);
);
test_color(red,255,0,0);
test_color(yellow,255,255,0);
test_color(green,0,255,0);
test_color(cyan,0,255,255);
test_color(blue,0,0,255);
test_color(magenta,255,0,255);
end(
run(' red=',v2s(red),
' yellow=',v2s(yellow),
' green=',v2s(green),
' cyan=',v2s(cyan),
' blue=',v2s(blue),
' magenta=',v2s(magenta))
); I"
if narg($colors)
l[] {
repeat narg($colors) {
color=${arg0\ $>,$colors}
if ${mode_$color}==2 (${$color},${R$color},${G$color},${B$color},${H$color},${S$color},${V$color})
else (${$color},${$color},0,0,0)
fi
}
a y permute yzcx
s c,-3 srgb2rgb[0,1] rgb2hsv[0,1] /. 100
f.. "
Hs = i(#0,x,0,0,0); Ss = i(#0,x,0,0,1); Vs = i(#0,x,0,0,2);
Hd = i0; Sd = i1; Vd = i2;
DeltaH = Hd - Hs;
alphaH = i(#2,x,0,0,0);
H = abs(DeltaH)<abs(DeltaH - 360)?
lerp(Hs,Hd,alphaH):
lerp(Hs,Hd - 360,alphaH)%360;
S = lerp(Ss,Sd,i(#2,x,0,0,1));
V = lerp(Vs,Vd,i(#2,x,0,0,2));
[ H,S,V ]"
rm.
hsv2rgb rgb2srgb
repeat w { color=${arg0\ $>,$colors} t_$color:=I[$>] }
-. .. a c
if 0$_is_preview 33,33,33,4 else 63,63,63,4 fi
f.. "I(#-1,round([i0,i1,i2]*(w#-1-1)/255))+=[i3,i4,i5,1];"
s. c,-3 +max. 1 /[-3,-1] eq. 0
inpaint_pde.. . rm[-3,-1]
2,2,2,3,"[x,y,z]*255" ri. ..,3 +[-2,-1]
=> clut
}
if $clut map_clut.. . rm. c 0,255 fi
fi
if $preview_mapping
__px,__py,__ps:=s=min(w,h);p=$preview_mapping;p==1?[0.5,0.5,80]:p==2?[0,0,48]:p==3?[1,0,48]:p==4?[0,1,64]:[1,1,64]
l[] {
repeat narg($all_colors) { color=${arg0\ $>,$all_colors} (${$color}) } a y permute. yzcx
s x r {s=round(max($__ps,16));[s,s]}
foreach[0-{narg($all_colors)-1}] {
color=${arg0\ $>,$all_colors}
mode=${mode_$color}
if $mode==2
polygon 3,0,100%,100%,100%,100%,0,1,${t_$color}
line 0,100%,100%,0,0.5,0xAAAAAAAA,255 line 0,100%,100%,0,0.5,0x55555555,0
fi
to {`uppercase(['$color'][0])`},0.5~,0.5~,50%,2,0.5
to_rgba
if $mode frame xy,1,0,0,0,255 frame xy,2,255 else frame xy,3,0,0,0,64 fi
}
append_tiles 3,3
store __preview_mapping
}
fi
} a c }
fx_tune_hsv :
_fx_tune_hsv ${1-63},0
fx_tune_hsv_preview :
preview_mapping=$64
foreach {
gui_split_preview "_is_preview=1 _fx_tune_hsv $*",${-3--1}
if $preview_mapping
$__preview_mapping
if narg($_preview_area_width) rs[0] $_preview_area_width,$_preview_area_height,2 fi
s. c,-3 to_colormode.. {-3,s}
j... ..,$__px~,$__py~,0,0,1,.,255 rm[-2,-1]
fi
}
d,l,a,r,y,g,c,b,m:=[$1==2?2:0,$8==2?2:0,$15==2?2:0,$22==2?2:0,$29==2?2:0,$36==2?2:0,$43==2?2:0,$50==2?2:0,$57==2?2:0]
u "{$1}{$2,$3,$4}_"$d"{$5}_"$d"{$6}_"$d"{$7}_"$d"{$8}{$9,$10,$11}_"$l"{$12}_"$l"{$13}_"$l"{$14}_"$l"{$15}{$16,$17,$18}_"$a"{$19}_"$a"{$20}_"$a"{$21}_"$a"{$22}{$23,$24,$25}_"$r"{$26}_"$r"{$27}_"$r"{$28}_"$r"{$29}{$30,$31,$32}_"$y"{$33}_"$y"{$34}_"$y"{$35}_"$y"{$36}{$37,$38,$39}_"$g"{$40}_"$g"{$41}_"$g"{$42}_"$g"{$43}{$44,$45,$46}_"$c"{$47}_"$c"{$48}_"$c"{$49}_"$c"{$50}{$51,$52,$53}_"$b"{$54}_"$b"{$55}_"$b"{$56}_"$b"{$57}{$58,$59,$60}_"$m"{$61}_"$m"{$62}_"$m"{$63}_"$m"{$64}{$65}{$66,$67}"
fx_custom_transform :
to_rgba repeat $! {
f. "$1"
s. c a[-4--2] c f.. "$2"
s.. c f[-4] "$3" f... "$4" f.. "$5" f. "$6"
if !$7 a[-4--1] c c. 0,255
elif $7==1 a[-4--2] c n.. 0,255 c. 0,255 a[-2,-1] c
else a[-4--1] c n. 0,255
fi
mv. 0 }
fx_vibrance :
foreach {
split_opacity l[0] {
to_rgb
f "const vibrance = 1 + $1;
vib(val) = (
v = val/255;
vv = (v - lum)*vibrance + lum;
(vv*(1 - sat) + v*sat)*255
);
min = min(R,G,B)/255;
lum = (R*0.2 + G*0.7 + B*0.1)/255;
sat = cut(1 - min/lum,0,1);
[ vib(R),vib(G),vib(B) ]"
c 0,255
}
a c
}
fx_tk_vintage :
repeat $! l[$>]
to_rgb[0] +luminance[0] +luminance[0] +luminance[0]
fx_mix_lab[0] $2,{$1*10},0,$3,0,0,$3,0,0,0,2,0
tk_fx_channel_processing. 1,1,0,0,4,{$4/2.55},100,256,0,1,0,2,0,0
tk_fx_channel_processing.. 1,1,0,0,4,{$4/2.55},{$5/2.55},256,0,0,0,2,0,0
tk_fx_channel_processing... 1,1,0,0,4,0,{$5/2.55},256,0,1,0,2,0,0
to_gray[-1,-2,-3] fx_gaussian_blur[-1,-2,-3] $6,0,0,1,0,0,0
+fc[0] $7,$8,$9 +fc[0] $11,$12,$13 +fc[0] $15,$16,$17 to_rgba[-1,-2,-3]
s. c rv[-1,-9] compose_multiply[-1,-9] mv[-8] 9 a[-4,-3,-2,-1] c
s.. c rv[-2,-8] compose_multiply[-2,-8] mv[-7] 7 a[-5,-4,-3,-2] c
s... c rv[-3,-7] compose_multiply[-3,-7] mv[-6] 5 a[-6,-5,-4,-3] c
+fc[0] $19,$20,$21 rv[-1,-5]
if $22==0 fx_compose_exclusion[-1,-5] $23
elif $22==1 fx_compose_overlay[-1,-5] $23
elif $22==2 fx_compose_softlight[-1,-5] $23
elif $22==3 fx_compose_multiply[-1,-5] $23
elif $22==4 fx_compose_screen[-1,-5] $23
fi
rv[-3,-4] fx_compose_lighten[-3,-4] $10
rv[-2,-3] fx_compose_overlay[-2,-3] $14
rv[-1,-2] fx_compose_darken[-1,-2] $18
if $25!=0
+fc[0] 255,255,255 fx_frame_round_old. 2,$24,0,0,0,0,0,255,100,0.1,3
fx_gaussian_blur. {$6*5},0,0,1,0,0,0
rv[-1,-2] fx_compose_multiply[-1,-2] $25 fi
done done
