foreach {
wh:=w,h
+diffusiontensors ${5-8}
rs. {max(1,w*$1%)}
dt. {round(125/max(1,$1))},$2,{$3<3?$3:0},$4
if $3==3
remove_opacity.. r.. .,.,1,100%,3 blend[0] [1],shapeaverage0 dilate. {1+2*$4} a c
