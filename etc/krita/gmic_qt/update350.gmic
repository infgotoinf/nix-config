if $location_of_bracket!=-1
('$1')
crop. $location_of_bracket,{w#-1-1}
img_arg={t}
rm.
pass$img_arg 0
_rep_transfer_color_reduced[^-1] $mode,[-1],${2-10}
rm.
else _rep_transfer_color_reduced $mode,${1-10}
fi
else
pass$1 0
_rep_transfer_color_reduced[^-1] $mode,[-1],${2-14}
rm.
fi
