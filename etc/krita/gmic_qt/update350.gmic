eval. $mode"
const S=s#-2;
const max_sum=$2;
const dec_max_sum=max_sum-1;
const end_pos=S-1;
const dec_end_pos=end_pos-1;
v=vector(#S);
t=J(-1);
index=p=t[0]<<24|t[1];
index?(
check_scanline=use_index=1;
sections_count=max_sum;
level_id=end_pos;
t_sum=0;
repeat(end_pos,q,
left_blocks_group_size=total_block_length=0;
repeat(sections_count,r,
left_blocks_group_size=total_block_length;
total_block_length+=perm(level_id,level_id+(sections_count-r),0);
if(total_block_length>index,break(););
);
--level_id;
index-=left_blocks_group_size;
sections_count-=r;
v[q]=r;
if(check_scanline?r,
scanline_pos=q;
check_scanline=0;
);
if(q<end_pos,
t_sum+=r;
);
if(!sections_count,
use_index=0;
break();
);
);
if(use_index,
v[end_pos]=index;
);
sum_v=t_sum+v[end_pos];
limit=max_sum-t_sum;
mode=sum_v!=max_sum;
):(
scanline_pos=end_pos;
mode=1;
limit=max_sum;
);
I[#-2,p]=v;
i=i0<<24|i1;
while(++p<i,
mode?(
if((++v[end_pos]) == limit,
mode=0;
);
):(
