fx_frame_mirror :
foreach {
{100+2*$1}%,{100+2*$2}%,1,100%,"
const boundary = 3;
const offx = (w - w#-1)*$3%;
const offy = (h - h#-1)*$4%;
const f_left = 2^$5;
const f_right = 2^$6;
const f_up = 2^$7;
const f_bottom = 2^$8;
x = x - offx;
y = y - offy;
x<0?(x*=-f_left):
x>=w#-1?(x = w#-1 - 1 - f_right*(x - w#-1));
y<0?(y*=-f_up):
y>=h#-1?(y = h#-1 - 1 - f_bottom*(y - h#-1));
I(#-1,x,y)" k.
}
