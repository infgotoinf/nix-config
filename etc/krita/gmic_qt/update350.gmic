+Je_passe_l_hiver_en_Floride[-2]
done
rm[-1,-3]
if {abs($Valeur_Plasma)}>0
$Largeur_Origine,$Hauteur_Origine,1,3
plasma[-1] {abs($Valeur_Plasma)},{abs($Valeur_Plasma)}
n[-1] 0,255
else
+Je_passe_l_hiver_en_Floride[-1]
fi
