+shape_menger : l[] { check "isint(${1=3},0)" nbi=$1 onfail noarg nbi=3 }
e[^-1] "Input a "$nbi"-iterated Menger sponge, as a 3D binary image."
3,3,3,1,"norm([x,y,z]-1)>1" (1)
