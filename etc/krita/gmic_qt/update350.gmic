w[] {*,d,e} rmn window_view
fi
if $is_CTRL
if {*,-D}
nw,nh:=round(1.25*[{*,w,h}])
if $nw<{*,u}" && "$nh<{*,v} w[] $nw,$nh,-1,0 rmn window_view fi
elif {*,-C}
nw,nh:=round(0.75*[{*,w,h}])
if $nw>32" && "$nh>32 w[] $nw,$nh,-1,0 rmn window_view fi
