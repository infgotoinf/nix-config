#@cli :
#@cli : Author: Reptorian.
#@cli : Default values: '_name_pals_as_id=0'
+pal:
check "same('$1','*')?($#==2?isnum($-1):1):1"
v - _gmic_s=$? v +
_$0 $*
+_pal:
if same('$1','*')
ni=$!
_pal_385_pals
if isnum($-1)?$-1 echo pass name[$ni--1] ${-__pal_ids} fi
v + e[^-1] "Create palette(s) '"${-__pal_ids}"'." v -
return
fi
$=var
if ('$1')[0]==_'-'
rd,var1=1,{`str='$1';(str)[1,size(str)-1]`}
else rd=0
fi
m __$0_dict:"n_ids=$""# $""=d"
__$0_dict ${-__pal_ids}
um __$0_dict
