samj_blend_20220419[-1,-2] alpha
samj_blend_20220419[-1,-2] alpha
mul[-1] 255
isophotes[-1] 3
fi
{w},{h},1,4
repeat (w+h)/1.5
line[-2] 50%,50%,{u(100)}%,{u(100)}%,1,0,0,0,0
done
repeat (w+h)/2
line[-1] {u(100)}%,{u(100)}%,{u(100)}%,{u(100)}%,1,255,255,255,255
done
repeat (w+h)/5
point {u(100)}%,{u(100)}%,0,1,255,255,255,255
done
and[-1,-2]
if $Type_Rendu==0
dilate_circ[-1] $Dilatation
elif $Type_Rendu==1
i [-1]
i [-1]
dilate_circ[-3] $Dilatation
dilate[-2] 6,1
dilate[-1] 1,6
samj_blend_20220419[-1,-2,-3] alpha
elif $Type_Rendu==2
dilate_circ[-1] $Dilatation
sponge[-1] 5
fi
fi
