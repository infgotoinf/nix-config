n 0,255
resize $Largeur,$Hauteur
if $4==1 shift 50%,50%,0,0,2 resize {round($Largeur/$5)*$5},{round($Hauteur/$5)*$5} split y,$5 split x,$5 append y append x split y,$5 append x resize $Largeur,$Hauteur fi
}
