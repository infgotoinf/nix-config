shift[-2] {$Compensation_Decalage_Ombre_X}%,{$Compensation_Decalage_Ombre_Y}%,0,0,0
fi
samj_blend_20220419[-2,-1] alpha,1,1
else
if $Dilatation>1 dilate_circ[-1] $Dilatation fi
