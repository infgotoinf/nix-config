);
mx>=0?draw_cursor(mx,frame,h - 1 - frame,my,frame,w - 1 - frame);
"
fi
=> view
if $canvas_label_notification
sh[canvas_label_notification] 100%
j[view] [canvas_label_notification],1~,0,0,0,{min(1,$notification_opacity)},.,255
rm.
window_no_wait=1
else
window_no_wait=0
fi
w[view] -1,-1,0 rm[view]
if $window_no_wait wait 40 else wait fi
is_CTRL,is_mb,is_lmb,is_rmb:={*,CTRLLEFT}" || "{*,CTRLRIGHT},{*,b}&3,{*,b}&1,{*,b}&2
