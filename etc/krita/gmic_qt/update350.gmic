isophotes[-1] 6
100%,100%,1,1
noise[-1] 0.5,1
lt[-1] {$Less_Than_Staroutline-0.5}
mul[-1,-2]
shape_star ,
garagecoder_example_shapecloud[-2] [-1],$Shapecloud_Staroutline
rm[-1]
elif $Choice_Filter==1
normalize[-1] 0,255
