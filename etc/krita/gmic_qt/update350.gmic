items_list=["$v_list"];
t=J(-1);
p=t[0]<<24|t[1];
p?(
div_list=vector(#S,1);
tv=1;
repeat(d_s,q,
div_list[dec_d_s-q]=tv*=items_list[d_s-q];
);
v=int(p/div_list)%items_list;
):(
v=vector(#S,0);
);
--items_list;
I[#-2,p]=v;
