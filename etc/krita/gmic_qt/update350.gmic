arg0(OUT#_interpolation,
0,
OUT#_is_downscale?4:2, # Nearest neighbor
OUT#_is_downscale?1:2, # Moving average (downscale) / nearest-neighbor (upscale)
OUT#_is_downscale?1:2, # Moving average (downscale) / linear (upscale)
