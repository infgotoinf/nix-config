const OUT0#_depth = OUT0#_axis==_'z'?size0:IN#_depth;
const OUT0#_spectrum = OUT0#_axis==_'c'?size0:IN#_spectrum;
const OUT1#_width = IN#_width - (OUT0#_axis==_'x'?size0:0);
const OUT1#_height = IN#_height - (OUT0#_axis==_'y'?size0:0);
