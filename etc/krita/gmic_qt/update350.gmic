gcd_hio_levels : skip ${1=1},${2=1},${3=39},${4=0},${5=1},${6=1},${7=0},${8=0},${9=0},${10=0}
if $8 _gcd_hio_levels[0] ${1--4} else _gcd_hio_levels ${1--4} fi
