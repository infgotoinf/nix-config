{w},{h},1,1,"begin(
const cx=(w-1)/2;
const cy=(h-1)/2;
const scaleP=$1?1:.5;
const wx=.043333;
const wy=.053333;
const a=.7;
const TWO_PI=pi*2;
const off_x=cx*($1==0?((1-$2%2)?1));
const off_y=cy*($1==0?($2>1?1));
);
xx=scaleP*x/w;
yy=scaleP*y/h;
for(n=0,n<10,++n,
newx=xx+wx-a/(TWO_PI*sin(TWO_PI*yy));
newy=yy+wy-a/(TWO_PI*sin(TWO_PI*xx));
xx=(newx+off_x)%w;
yy=(newy+off_y)%h;
i(#0,xx,yy)++;
);"
rm..
if $3!=0 r. $ww,$hh,100%,100%,2 fi
n. 0,255
