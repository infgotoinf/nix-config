__fx_extrude25d :
depth,angx,angy,shear,negate,normal_smoothness,shading,Rt,Gt,Bt,Rr,Gr,Br,Rb,Gb,Bb,Rl,Gl,Bl:=${1-19}
angle:=rad2deg(atan2($angy-50,$angx-50))
fx_extrude25d :
__fx_extrude25d $*
foreach {
w,h:=w,h
shear_factor:=1-$shear%
is_alpha:=isin(s,2,4)
if $is_alpha s. c,-{s-1} n. 0,1 if iM k. else rm. is_alpha=0 fi fi
if !$is_alpha norm. n. 0,1 fi
if $angle rotate. $angle,1,0 fi
if $shear r. 100%,{max(1,$shear_factor*h)},1,100% fi
if $negate negate. else autocrop. fi
frame. xy,1,{$negate?1:0}
+ge[0] 20% l. {
edgels -1
foreach {
s c,-2 channels. 0,1 f. "arg0(i0,[1,0],[0,1],[-1,0],[0,-1])" a c
1,1,1,4
eval.. ">begin(y0 = 0; XY0 = N = [ -1,-1 ]);
XY = [ i0,i1 ];
XY!=XY0?(
y0?(da_push([ XY,unitnorm(N/max(1,y - y0)) ]));
y0 = y; N = [ i2,i3 ]; XY0 = XY;
):(
N+=[ i2,i3 ];
); end(da_freeze())"
rm..
if h>1
s. c,-2
repeat 2 { median. 5 }
b. y,$normal_smoothness,2
orientation. a c
fi
}
a y
}
{0,[w,h]},1,4
eval.. "begin(
colr = [ "$Rr,$Gr,$Br" ];
colb = [ "$Rb,$Gb,$Bb" ];
coll = [ "$Rl,$Gl,$Bl" ];
const N = max(1,20*(1 - $shading%^0.25));
);
ar = max(0,i2)^N;
ab = max(0,i3)^N;
al = max(0,-i2)^N;
col = (ar*colr + ab*colb + al*coll)/max(1e-8,ar + ab + al);
x = i0; y = i1;
x && y && x<w#-1-1 && y<h#-1-1?(I(#-1,i0,i1) = [ col,1 ])"
rm..
s. c,-3 f. "n = i; n?(I(#-2)/=n; 1):0" # Perform normal averaging on each point
. dilate.. 11 -[-2,-1] inpaint.. .,0,1 rm.
to_a.
if $negate line. 0,100%,100%,100%,1,$Rt,$Gt,$Bt,255 fi
depth:=int($h*$depth%)
{0,[w,h+($negate?0:$depth)]},1,4
1,$depth,1,1,">begin(M = crop(#0); S = crop(#1)); draw(#-1,S,0,$depth - y,0,0,w#1,h#1,1,s#1,1,M)" rm.
($Rt^$Gt^$Bt^255) r. [0],[0],1,4 j.. .,0,0,0,0,1,[0] rm.
k. c 0,255
if $_is_preview r. $_preview_area_width,$_preview_area_height,1,4,0,0,0.5,0.5
else r. {[max($w,w),max($h,h)]},1,4,0,0,0.5,0.5
fi
}
