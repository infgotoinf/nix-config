done
gcd_unstereo : skip ${1=5},${2=0.1},${3=0},${4=1},${5=1},${6=1},${7=0},${8=0}
repeat $! l[$>]
if $4" && "$8 pr=1 else pr=$1 fi
to_rgb[0] split_tiles[0] $5,$6
repeat $! l[$>]
s[0] c +equalize[0,1] 256
+displacement.. .,$2,$pr
if $3 sh. 1,1 f. 0 rm. fi
/. 2 warp[1,2] .,1 *. -1 warp[0] .,1
k[0-2] a c c[0] 0,255
done done
append_tiles $5,$6
done done
