_parse_gui_json :
l[] {
('{/"$*"}')
replace_str "\\","\\\\"
replace_str "\n","\\n"
replace_str "\r","\\r"
replace_str "\"","\\\""
replace_str "&amp;","&"
replace_str "&nbsp;"," "
replace_str. "<i>",""
replace_str. "</i>",""
replace_str. "<b>",""
replace_str. "</b>",""
replace_str. "<small>",""
replace_str. "</small>",""
u {t} rm
onfail u "" rm
}
