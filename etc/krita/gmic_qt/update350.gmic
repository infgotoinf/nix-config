_jr_smooth_eq_prepare :
f. "begin(scale=((w^2+h^2+d^2)^0.5)/2;ol=$2^3;oh=$25^3;ql=(2-2/(($3+1)^2));qh=(2-2/(($26+1)^2));rsl=1/(2^$1);rsh=1/(2^$24);ol=$2^3;oh=$25^3;
order1=$5^3;band1=$6^2;gain1=$7;
order2=$9^3;band2=$10^2;gain2=$11;
order3=$13^3;band3=$14^2;gain3=$15;
order4=$17^3;band4=$18^2;gain4=$19;
order5=$21^3;band5=$22^2;gain5=$23);
vx=(x-w/2);vy=(y-h/2);vz=(z-d/2);rad=((vx^2+vy^2+vz^2)^0.5)*scale/16;
fl=rad*rsl;
fh=(rad*rsh)^-1;
func=(1/((1-ql*(fl)^(ol/2)+(fl)^(ol))^0.5));
func*=2^(gain1/sqrt(1+2*abs(log2(rad/(2^"$4"))/(band1))^order1));
func*=2^(gain2/sqrt(1+2*abs(log2(rad/(2^"$8"))/(band2))^order2));
func*=2^(gain3/sqrt(1+2*abs(log2(rad/(2^"$12"))/(band3))^order3));
func*=2^(gain4/sqrt(1+2*abs(log2(rad/(2^"$16"))/(band4))^order4));
func*=2^(gain5/sqrt(1+2*abs(log2(rad/(2^"$20"))/(band5))^order5));
func*=(1/((1-qh*(fh)^(oh/2)+(fh)^(oh))^0.5));
func"
