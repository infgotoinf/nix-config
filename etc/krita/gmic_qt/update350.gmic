samj_Image_Vers_Segments :
foreach {
if $9>0 srand $9 fi
to_rgba
{w},{h},1,4
rv
repeat $1
X1p={round(u*{w})}
Y1p={round(u*{h})}
X2p={$X1p+round(u*$2/100*{h})+1}
Y2p={$Y1p+round(u*$2/100*{h})+1}
Pixel={I($X1p,$Y1p)}
Rp={arg(1,$Pixel)}
Vp={arg(2,$Pixel)}
Bp={arg(3,$Pixel)}
Ap={arg(4,$Pixel)}
if $2>0
line.. $X1p,$Y1p,$X2p,$Y2p,1,$Rp,$Vp,$Bp,$Ap
else
X2p={$X1p+round(u/100*{h})+1}
Y2p={$Y1p+round(u/100*{h})+1}
a_Ligne={{$Y2p-$Y1p}/{$X2p-$X1p}}
b_Ligne={$Y2p-($a_Ligne*$X2p)}
X_Ex_a=0
Y_Ex_a=$b_Ligne
X_Ex_b={{w}-1}
Y_Ex_b={{$a_Ligne*$X_Ex_b}+$b_Ligne}
if $Y_Ex_b>=0 line.. $X_Ex_a,$Y_Ex_a,$X_Ex_b,$Y_Ex_b,1,$Rp,$Vp,$Bp,$Ap fi
fi
done
if $3>1 dilate_circ.. $3 fi
rm.
if $4 {w},{h},1,4 fill_color. $5,$6,$7,$8 rv blend alpha fi
if $10 dilate. {$3+1} deform $10 fi
}
