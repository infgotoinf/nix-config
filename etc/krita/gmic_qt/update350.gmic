fx_conformal_maps :
to_a
expr0="$4"
expr1="z"
expr2="(z+1)/(z-1)"
expr3="cos(z)"
expr4="sin(z)"
expr5="tan(z)"
expr6="exp(z)"
expr7="log(z)"
expr8="1/(4*z^2-1)"
expr9="-5*(z^3/3-z/4)/2"
('${expr$1}')
replace_str. "*","**"
replace_str. "/","//"
replace_str. "^","^^"
replace_str. "exp(","cexp("
replace_str. "log(","clog("
replace_str. "cos(","ccos("
replace_str. "sin(","csin("
replace_str. "tan(","ctan("
expr={t}
rm.
foreach {
wh:=$12?[$13,$14]:[w,h]
{(1+$11)*[$wh]},1,100%
f. "begin(
ccos(z) = (iz = [ -z[1],z[0] ]; (cexp(iz) + cexp(-iz)/2));
csin(z) = (iz = [ -z[1],z[0] ]; (cexp(iz) - cexp(-iz)/2));
ctan(z) = csin(z)//ccos(z);
boundary = $10;
interpolation = 1;
const f = max(w,h);
const f0 = max(w#0,h#0);
i = [0,1];
);
z = (2*[ x,y ] - [ w,h ])/f;
z = rot(-$6°)*z;
z-= [ $8, $9 ];
z/=[ 10^($5 + $7), 10^$5 ];
z = ("$expr");
if ($1, z = z^^[$2,$3]);
z = rot($6°)*z;
z = 0.5*(f0*z + [w#0,h#0]);
I(#0,z)"
r. $wh,1,100%,2
rm..
}
