u "{"$p"}{"$q"}{"$size"}{"$nb_iter"}{"$angle"}{"$tiling"}{"$antialiasing"}{"$filling"}""{"$shiftx,$shifty"}_"$v_image"{"$zoom"}_"$v_image"{"$iangle"}_"$v_image"{"$outline"}_"$v_image"{"$Ro,$Go,$Bo"}_"$v_image"{"$R0,$G0,$B0"}_"$v_binary"{"$R1,$G1,$B1"}_"$v_binary
