if $5==1
noise[0] {$1/1},4
+fx_bwrecolorize 1,1,0,0,0,1,0,5,0,0,0,255,47,106,121,255,209,136,49,255,228,207,191,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,0
fx_compose_edges 0.9,0.5
