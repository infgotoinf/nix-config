opening_offset = underline;
res[underline++] = s_underline; res[underline] = 0;
res[y] = e_underline; res[y1] = 0;
);
):
non_escaped && c==_'`'?(
monospace<0?(
monospace = y;
):
monospace>=0 && y>monospace + 1?(
opening_offset = monospace;
res[monospace++] = s_monospace;
copy(res[monospace],i[monospace],y - monospace);
for (p = monospace, p<y, ++p, res[p]==_' '?(res[p] = s_whitespace));
res[y] = e_monospace;
);
):
non_escaped && c==_'{' && value_set<0 && semiblank(pc)?(
value_set = y;
):
non_escaped && c==_'}' && value_set>=0 && y>value_set + 1 && semiblank(nc)?(
