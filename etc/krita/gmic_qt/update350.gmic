m $0_process_$""1:+$0_bsoo_edit\\ $method,$effect_factor,$multiplication\\ _blend_$blending_id\\ if\\ $opacity<1\\ j..\\ .,0,0,0,0,$opacity\\ rm.\\ else\\ k.\\ fi\\ cut\\ 0,255
fi
