#@cli rep_BIGINT_division: decimal_number>=0,1<=divisor<=16777216
#@cli : Perform division on decimal number, then return the value. Supports 1000+ digits positive integer number for decimal_number only!
rep_BIGINT_division:
check m=1<<24;(inrange($1,0,m,1,1)?isint($1,0,m):1);isint($2,1,m)
if $1<(1<<53) status {int($1/$2)}
elif $2>$1    status 0
elif $2==1    status $1
elif $1==$2   status 1
else
('$1')
if im<_'0'||iM>_'9' error inv_num fi
eval "
const _0=_'0';
const divisor=$2;
const init_shift_num=int(log10(divisor));
const start_digits_count=init_shift_num+1;
const LenDecStr=w#-1;
start_num=0;
repeat(start_digits_count,p,
start_num=start_num*10+i[#-1,p]-_0;
);
start_num>=divisor?(
tmp=int(start_num/divisor);
i[#-1,0]=tmp+_0;
remainder=start_num-tmp*divisor;
shift_num=init_shift_num;
):(
shift_num=init_shift_num+1;
remainder=start_num;
);
for(p,p<LenDecStr,++p,
tmp=remainder*10+i[#-1,p]-_0;
new_num=int(tmp/divisor);
remainder=tmp-new_num*divisor;
i[#-1,p-shift_num]=new_num+_0;
);
set('trim_end_point',LenDecStr-shift_num-1);"
crop. 0,$trim_end_point status {t} rm.
fi
#@cli rep_posdec2altbase_num: base,positive_decimal
#@cli : Return decimal into specified base using series of digits represented in base 10 separated by comma.
rep_posdec2altbase_num:
base_float_max:=1<<24
check "isint($2,0)"
if isnum($1)
base=$1
else
base_bin,base_oct,base_dec,base_hex=2,8,10,16
base=${base_$1}
fi
check "isint($base,2,$base_float_max)"
if $2<(1<<53)
eval "expr('<begin(
const base=$base;
n=$2;
);
remainder=n%base;
n=int(n/base);
remainder;
',1+int(log($2)/log($base)));"
return
fi
positive_decimal_start_pos,S={V='$2';[for(p=0,V[p]==_'0',++p);,size(V)]}
positive_decimal:=('$2')[$positive_decimal_start_pos,$S-$positive_decimal_start_pos]
if isint(log10($base))
if !$2 u 0 return fi
if $base==10
u {["$positive_decimal"]-_'0'}
else
u {"decimal=["$positive_decimal"];
const num_of_digits_per_section=log10($base);
const order_of_magnitude_base_10=size(decimal);
const new_vector_size=ceil(order_of_magnitude_base_10/num_of_digits_per_section);
const K_d=order_of_magnitude_base_10%num_of_digits_per_section;
new_vector=vector(#new_vector_size);
if(K_d,
new_vector[0]=s2v((decimal)[0,K_d]);
);
insertion_pos=new_vector_size;
for(pos=order_of_magnitude_base_10-num_of_digits_per_section, pos>=0, pos-=num_of_digits_per_section,
new_vector[--insertion_pos]=s2v((decimal)[pos,num_of_digits_per_section]);
);
new_vector;
"}
fi
return
fi
digits_per_sections,temp_base={dps=int(log($base_float_max)/log($base));[dps,$base^dps]}
exponent:=size('{$temp_base-1}')
($positive_decimal) 1,1,1,1
{ceil(w#-2/$exponent)},1,1,2,"begin(
const base_float=$base_float_max;
const bit_mask=base_float-1;
pos=started=0;
int2float_max(v)=[v>>24,v&bit_mask];
);
if(started
,pos+=$exponent;
,pos=w#-2-$exponent*(w-x);started=1;
);
val=crop(#-2,pos,0,0,0,$exponent,1,1,1);
val+=!val;
int2float_max(s2v(val));
"
rm[-3]
eval "
const base_float=$base_float_max;
const bit_mask=base_float-1;
const divisor=$temp_base;
const multiplier=1e"$exponent";
float_max2int(v)=v[0]<<24|v[1];
int2float_max(v)=[v>>24,v&bit_mask];
while(w(#-1)>1||float_max2int(I[#-1,w(#-1)-1]),
crop_point=nan;
remainder=current_number=0;
repeat(w(#-1),p,
current_number*=multiplier;
current_number+=float_max2int(I[#-1,p]);
remainder=current_number%divisor;
current_number>divisor?(
I[#-1,p]=int2float_max(int(current_number/divisor));
current_number=remainder;
if(isnan(crop_point),
crop_point=p;
);
[0,0];
):(
I[#-1,p]=[0,0];
);
);
da_insert(#-2,0,remainder);
if(!isnan(crop_point),
resize(#-1,w(#-1)-crop_point,1,1,2,0,0,crop_point,0,0,0);
);
);
da_freeze(#-2);
"
rm.
first_digits_set_size:=int(log(i[#-1,0])/log($base))
{$first_digits_set_size+(h#-1-1)*$digits_per_sections+1},1,1,1
eval.. "begin(
const sp=$first_digits_set_size;
const dps=$digits_per_sections;
const base=$base;
insertion_pos=started=0;
);
started?(
insertion_pos+=dps;
):(
insertion_pos=sp+dps*y;
started=1;
);
t_insertion_pos=insertion_pos;
n=i;
while(n,
i[#-1,t_insertion_pos--]=n%base;
n=int(n/base);
);
i;
"
u {crop(#-1)} rm[-2,-1]
#@cli rep_altbase_num2posdec: base,digit_a,digit_b,...
#@cli : Return the decimal number which corresponds to arguments.
rep_altbase_num2posdec:
base_float_max:=1<<24
if isnum($1)
base=$1
else
base_bin,base_oct,base_dec,base_hex=2,8,10,16
base=${base_$1}
fi
(${2--1})
crop. {for(p=0,!i[#-1,p],++p);set('p',p);p;},100%
check "( isint($base,2,$base_float_max) && im>=0 && iM<$base && $#>1 ) ? ( sum(isint(crop(#-1)))== w#-1 )"
if isint(log10($base))
exponent:=size('$base')-1
else
if w#-1<=int(log(1<<53)/log($base))
eval. <"begin(
