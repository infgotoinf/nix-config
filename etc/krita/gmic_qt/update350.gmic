foreach { split_opacity l[0] {
to_rgb
repeat $smoothness { smooth 60,0,1,1,1 progress {lerp(0,25,($>+1)/($>+$<+1))} }
+colormap. $levels,0 round. index.. .
[0],[0],1,3 fc. $bgr,$bgg,$bgb
