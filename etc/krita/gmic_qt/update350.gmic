rep_concat_conset_fill:
check $!==1
startnum={max(abs($1),1)}
maxnum_a,maxnum_b,string_a,string_b=$startnum,{$startnum+(h-1)},"",""
repeat inf {
string_a.=$maxnum_a
maxnum_a-=1
if $maxnum_a==1||size('$string_a')>=w#0
startnum,string_a={max($maxnum_a,1)},""
break
fi
}
repeat inf {
string_a..=$maxnum_b
({size('$maxnum_b')})
if $> a[-2,-1] x fi
maxnum_b-=1
if $maxnum_b<$startnum break fi
}
ts,digits={is#-1},0
repeat inf {
string_b..={$>+1}
digits+={size('{$>+1}')}
