else
nbp,nbq=$2,$2
1,{$nbp*$nbq},1,4,"const nbp = "$nbp"; const nbq = "$nbq";
p = y%nbp;
q = int(y/nbp);
x = p*100/(nbp - 1);
y = q*100/(nbq - 1);
[ x,y,x,y ]"
nbc=$3
if $nbc>0
+b[0] 0.5 gradient_norm. sqrt. {round([w,h]/4)} gaussian. 20%
1,$nbc,1,4,">
begin(gauss = crop(#-1));
st = stats(#-2);
iM = st[1];
xM = st[8];
yM = st[9];
img = vector(#w#-1*h#-1,-iM);
draw(#-2,img,xM - w#-1/2,yM - h#-1/2,0,0,w#-1,h#-1,1,1,-1,gauss);
nxyM = [ xM,yM ]*100/([w#-2,h#-2]-1);
[ nxyM,nxyM ]"
rm[-3,-2]
a[-2,-1] y
fi
fi
+_x_warp_rbf. {0,round([w,h]/4)} *. 4 r. [0],[0],1,100%,3 +. '[x,y]' warp[0] .,0,1,3 rm.
eval. "*
begin(
col1 = [ 64,200,255 ];
const radius1 = 3;
const radius2 = radius1 + 2;
fact = ([ w#0,h#0 ] - 1)%
);
X = (I)[0,2]*fact;
ellipse(#0,X,radius2,radius2,0,1,0);
ellipse(#0,X,radius1,radius1,0,1,col1); I"
rm.
if narg($__x_warp_keypoints)
0 t. "Keypoints from previous\nrun have been saved",0,0,24,1,255
frame. 5,5,0 +dilate_circ. 5 a[-2,-1] c blend alpha
fi
}
_fx_warp_rbf_process :
boundary_conditions,lock,phi=${1-3}
phi=${"arg0 "$phi",sqrt(r),r,r*log(1+r)"}
$=arg
i,j=0,4 for narg(${arg$j}) {
sx$i=${arg$j} j+=1
sy$i=${arg$j} j+=1
tx$i=${arg$j} j+=1
ty$i=${arg$j} j+=1
i+=1
}
nbp:=$i
if !$nbp return fi
if !$boundary_conditions to_a fi
foreach {
$nbp,1,1,4 repeat w { point $>,0,0,1,{0,[${tx$>},${ty$>},${tx$>}-${sx$>},${ty$>}-${sy$>}]} }
if $lock
{$lock>1?6:1},1,1,2x4
f[-4] "[ lerp(0,100,x/w),0 ]" f... "[ 100,lerp(0,100,x/w) ]"
f.. "[ lerp(100,0,x/w),100 ]" f. "[ 0,lerp(100,0,x/w) ]"
a[-4--1] x channels. 0,3 a[-2,-1] x
fi
rbf. {0,[w,h,0,0,100,100]},$phi sh. 0 *. {0,(w-1)%} rm. sh. 1 *. {0,(h-1)%} rm.
warp[0] .,1,1,$boundary_conditions rm.
}
_fx_warp_rbf :
mode,previous_mode,boundary_conditions,lock,phi,x0,y0,sx0,sy0,tx0,ty0,x1,y1,sx1,sy1,tx1,ty1,x2,y2,sx2,sy2,tx2,ty2,x3,y3,sx3,sy3,tx3,ty3,x4,y4,sx4,sy4,tx4,ty4,x5,y5,sx5,sy5,tx5,ty5,x6,y6,sx6,sy6,tx6,ty6,x7,y7,sx7,sy7,tx7,ty7,x8,y8,sx8,sy8,tx8,ty8,x9,y9,sx9,sy9,tx9,ty9,x10,y10,sx10,sy10,tx10,ty10,x11,y11,sx11,sy11,tx11,ty11,x12,y12,sx12,sy12,tx12,ty12=${1-83}
nbp=13
if $_is_preview" && "!$mode
sh. 0,{isin(s,2,4)?s-2:s-1} *. 0.75 rm.
fi
repeat $nbp {
x,y=${x$>},${y$>}
if isnan($x) continue fi
if $mode==$previous_mode
if $mode tx$>,ty$>=$x,$y
else
if [$x,$y]!=[${sx$>},${sy$>}] sx$>,sy$>,tx$>,ty$>=$x,$y,$x,$y fi
fi
else
if $mode x$>,y$>=${tx$>},${ty$>}
else x$>,y$>=${sx$>},${sy$>}
fi
fi
}
if $mode
p_args,c= repeat $nbp {
if isnan(${x$>}) continue fi
p_args.=$c${sx$>},${sy$>},${tx$>},${ty$>} c=,
}
_fx_warp_rbf_process $boundary_conditions,$lock,$phi,$p_args
fi
if $_is_preview
u "{"$mode"}{"$mode"}{"$boundary_conditions"}{"$lock"}{"$phi"}""{"$x0,$y0"}{"$sx0,$sy0"}{"$tx0,$ty0"}""{"$x1,$y1"}{"$sx1,$sy1"}{"$tx1,$ty1"}""{"$x2,$y2"}{"$sx2,$sy2"}{"$tx2,$ty2"}""{"$x3,$y3"}{"$sx3,$sy3"}{"$tx3,$ty3"}""{"$x4,$y4"}{"$sx4,$sy4"}{"$tx4,$ty4"}""{"$x5,$y5"}{"$sx5,$sy5"}{"$tx5,$ty5"}""{"$x6,$y6"}{"$sx6,$sy6"}{"$tx6,$ty6"}""{"$x7,$y7"}{"$sx7,$sy7"}{"$tx7,$ty7"}""{"$x8,$y8"}{"$sx8,$sy8"}{"$tx8,$ty8"}""{"$x9,$y9"}{"$sx9,$sy9"}{"$tx9,$ty9"}""{"$x10,$y10"}{"$sx10,$sy10"}{"$tx10,$ty10"}""{"$x11,$y11"}{"$sx11,$sy11"}{"$tx11,$ty11"}""{"$x12,$y12"}{"$sx12,$sy12"}{"$tx12,$ty12"}"
fi
fx_warp_rbf :
_is_preview=0
_fx_warp_rbf $*
fx_warp_rbf_preview :
