fx_pills :
$=arg n:=$1?4:2
foreach {
w,h={w},{h} rm
repeat $1?3:1 {
$w,$h,1,1,"begin(
const cyc = "${arg$n}"*pi;
const ang = "${arg{1+$n}}"°;
const M = max(w,h);
R = rot(ang);
);
x0 = lerp(-cyc,cyc,x/M);
y0 = lerp(-cyc,cyc,y/M);
x = x0*R[0] + y0*R[1];
y = x0*R[2] + y0*R[3];
sqrt(abs(sin(x + cos(y + sin(x + cos(y)))) * sin(y + cos(x + sin(y + cos(x))))))"
n+=2
}
n 0,255
a c
}
