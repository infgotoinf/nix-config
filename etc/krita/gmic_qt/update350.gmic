colorSoFarA=colorSoFarA+(ColorOutA*ColorOutA*alphaRemaining);
alphaRemaining=alphaRemaining*(1-ColorOutA);
if(transparentPointsIn && alphaRemaining>epsilon,sign=-1);
if(!transparentPointsIn && alphaRemaining>epsilon,sign=1),
radius=sqrt(z*z+zi*zi);
