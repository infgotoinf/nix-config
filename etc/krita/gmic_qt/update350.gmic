foreach {
wh:=w,h rm
$wh,1,{$6?3:1} rand. 0,255
$wh rand. {$3*pi/180-$4*10*pi},{$3*pi/180+$4*10*pi} +sin. cos.. a[-2,-1] c
r[-2,-1] 130%,130%,1,100%,0,2,0.5,0.5 b. $2 orientation.
vector2tensor.
smooth.. .,$1,0.5,20 rm.
r. $wh,1,100%,0,0,0.5,0.5
if $5!=1 ia:=ia - $ia * $5 + $ia fi
}
