elif $5==3 rotate 90
elif $5==4 rotate 180
elif $5==5 rotate 270
fi
if $7
if !$4 columns 0,{100-$7}%
elif $4==1 rows 0,{100-$7}%
elif $4==2 z 0,0,{100-$7}%,{100-$7}%
elif $4==3 z {$7/2}%,{$7/2}%,{100-$7/2}%,{100-$7/2}%
fi
fi
shift -$2%,-$3%,0,0,2
array_mirror $1,$4,$6
